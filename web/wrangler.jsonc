{
  // Serves the Next.js static export (npm run build writes ./out) as Workers static assets. The script (worker/index.js)
  // runs only for /api/* (run_worker_first): the grade-change email alerts. Every other request is pure static.
  // Deploy: fleet.yml and release-sync.yml deploy main; by hand `npm run build && npx wrangler deploy`.
  // Alerts are on: NOTIFY_LIVE "1" (here; a dashboard value is overwritten by the next deploy) and the NOTIFY_SECRET
  // secret (set on the Worker 2026-11-12). Kill switch: set NOTIFY_LIVE to "0" and deploy; sends are then only logged.
  // D1 migrations are not applied by the deploy: after adding one run `npx wrangler d1 migrations apply sealmark-notify
  // --remote` (the hourly tick refuses to run until 0002 is in).
  // Optional, all unset: NOTIFY_MASS_CHANGE "baseline" or "send" releases a held mass change (worker/index.js) for one
  // deploy; NOTIFY_TURNSTILE "1" requires a Turnstile token on subscribe, with the TURNSTILE_SECRET secret and the
  // public TURNSTILE_SITE_KEY for the form (no widget exists yet, so leave it off).
  "name": "sealmark",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "sealmark.dev", "custom_domain": true },
    { "pattern": "www.sealmark.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sealmark-notify",
      "database_id": "121844a2-b776-4888-ba48-8d271f93fee3",
      "migrations_dir": "worker/migrations"
    }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["30 * * * *"] },
  "vars": { "NOTIFY_LIVE": "1" },
  "observability": { "enabled": true }
}
